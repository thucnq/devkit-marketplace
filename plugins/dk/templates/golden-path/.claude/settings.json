{
  "extraKnownMarketplaces": {
    "thuc-devkit": {
      "source": { "source": "github", "repo": "__MARKETPLACE_REPO__" }
    }
  },
  "enabledPlugins": {
    "dk@thuc-devkit": true
  },
  "permissions": {
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(mvn:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(python3:*)",
      "Bash(docker compose:*)",
      "Bash(k6:*)"
    ],
    "deny": [
      "Read(./deploy/envs/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)"
    ]
  }
}
