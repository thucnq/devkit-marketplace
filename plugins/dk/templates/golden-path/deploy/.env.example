# Copy to deploy/envs/staging.env (never commit real env files — they are git-ignored).
# Generate secrets with: openssl rand -base64 48   (jwt)   /   openssl rand -base64 32   (pii keys)
DEPLOY_HOST=ubuntu@203.0.113.10        # or "local" to run on this machine / the client's workstation
DEPLOY_DIR=/opt/goldenpath
PUBLIC_URL=https://staging.example.vn
SITE_ADDRESS=staging.example.vn        # Caddy obtains HTTPS automatically for a real domain
APP=goldenpath
SPRING_PROFILES_ACTIVE=prod            # add ",google" when Google SSO is configured

POSTGRES_DB=app
DB_OWNER_USER=goldenpath
DB_OWNER_PASSWORD=change-me
DB_APP_PASSWORD=change-me-too

APP_JWT_SECRET=change-me-base64-48-bytes
APP_PII_KEY=change-me-base64-32-bytes
APP_PII_HASH_KEY=change-me-base64-32-bytes
APP_FRONTEND_URL=https://staging.example.vn
APP_COOKIE_SECURE=true
APP_AUDIT_RETENTION_MONTHS=3

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RCLONE_REMOTE=
