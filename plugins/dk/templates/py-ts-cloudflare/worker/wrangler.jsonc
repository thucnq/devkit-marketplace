// Cloudflare Worker: serves the web app (static assets from ../web/dist) and the JSON API under /api/*.
// Top level = PRODUCTION (`wrangler deploy` without --env). Agents may only use --env staging; the dk guard
// blocks the rest. database_id values are not secrets - fill them from `npx wrangler d1 create <name>`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldenpath",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "goldenpath-prod", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": { "APP_ENV": "production" },
  "env": {
    "staging": {
      "name": "goldenpath-staging",
      "d1_databases": [
        { "binding": "DB", "database_name": "goldenpath-staging", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "vars": { "APP_ENV": "staging" }
    }
  }
}
